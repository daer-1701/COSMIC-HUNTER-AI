# Hackathon demo: copying this file as-is is enough. No secrets are required.
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and GEMINI_API_KEY can stay empty.
# The demo API serves data/manifests/*.json and apps/web/public/previews/*.png.
# uvicorn does not load this file automatically; the API defaults below apply
# unless the variables are exported in the shell.

APP_ENV=development

# Used by the demo API (optional; these are the defaults).
CORS_ORIGINS=http://localhost:3000
IRSA_TIMEOUT_SECONDS=25
# MANIFESTS_DIR=data/manifests
# PREVIEWS_DIR=apps/web/public/previews

# Planned / optional: PostgreSQL and Redis (docker compose). Unused by the demo API.
DATABASE_URL=postgresql+psycopg://cosmic:local_dev_only@localhost:5432/cosmic
POSTGRES_USER=cosmic
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=cosmic
REDIS_URL=redis://localhost:6379/0

# Planned / optional: Gemini. No Gemini calls are implemented.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ENABLED=false
GEMINI_BUDGET_USD=4.00

# Planned / optional: S3 object storage. No S3 access is implemented.
S3_ENDPOINT_URL=
S3_BUCKET=cosmic-hunter
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
