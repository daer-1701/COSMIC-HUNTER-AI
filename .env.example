# Copying this file as-is is enough to run the API. No secrets are required:
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and GEMINI_API_KEY can stay empty.
# The API loads .env at startup; variables already set in the shell take precedence.
# Never put real keys in this file; put them only in .env (ignored by Git).

APP_ENV=development

# Demo API (these are the defaults).
CORS_ORIGINS=http://localhost:3000
IRSA_TIMEOUT_SECONDS=25
# MANIFESTS_DIR=data/manifests
# PREVIEWS_DIR=apps/web/public/previews
# STATE_DIR=data/state

# Gemini summaries (POST /v1/examples/{slug}/summary). Paid calls run only when
# GEMINI_ENABLED=true AND the key, model, both prices, and a positive budget are set.
# Prices: https://ai.google.dev/gemini-api/docs/pricing (gemini-3.5-flash-lite,
# paid tier, checked 2026-11-14). Re-check them when changing the model.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_INPUT_USD_PER_MTOK=0.30
GEMINI_OUTPUT_USD_PER_MTOK=2.50
GEMINI_BUDGET_USD=4.00
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_CALLS_PER_MINUTE=10

# Planned / optional: PostgreSQL and Redis (docker compose). Unused by the API.
DATABASE_URL=postgresql+psycopg://cosmic:local_dev_only@localhost:5432/cosmic
POSTGRES_USER=cosmic
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=cosmic
REDIS_URL=redis://localhost:6379/0

# Planned / optional: S3 object storage. No S3 access is implemented.
S3_ENDPOINT_URL=
S3_BUCKET=cosmic-hunter
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
